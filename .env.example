# LiveBridge gateway configuration. Copy to .env (git-ignored) and fill in. Never commit real values.
# The gateway validates everything at startup and refuses to start on a missing or malformed value.

HOST=127.0.0.1
PORT=8201

# real = ElevenLabs + Gemini. fake = deterministic placeholder text and test tones (no keys needed, not a translation).
PROVIDER_MODE=real

# Long-lived client credential (>= 32 characters). The desktop app stores it in the macOS Keychain.
# Generate one with:  openssl rand -base64 36
GATEWAY_ACCESS_TOKEN=

# --- ElevenLabs (speech-to-text and speech synthesis) ---
# Use a dedicated key with only Speech to Text + Text to Speech permissions and a monthly usage limit.
ELEVENLABS_API_KEY=
# Your own authorised cloned voice: used ONLY for your outgoing English / Russian speech.
ELEVENLABS_OWNER_VOICE_ID=
# A licensed stock voice for incoming Uzbek. Must differ from the owner voice; the remote speaker is never cloned.
ELEVENLABS_INCOMING_VOICE_ID=
# Optional regional host, e.g. https://api.eu.residency.elevenlabs.io
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
STT_MODEL=scribe_v3_live
STT_VAD_SILENCE_SECS=0.6
TTS_MODEL=eleven_v4_turbo
# Raw PCM only. Run `npm run probe` to confirm which pcm_<rate> values your plan accepts on the dialogue socket.
TTS_OUTPUT_FORMAT=pcm_24000

# --- Translation (Gemini streaming generateContent) ---
TRANSLATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Chosen by measurement on 2026-11-24 (docs/benchmark.md): fastest and most available of the candidates.
TRANSLATION_MODEL=gemini-3.5-flash-lite
# Same provider and privacy terms as the primary. Leave empty to disable fallback.
TRANSLATION_FALLBACK_MODEL=gemini-3.8-flash
# Comma-separated models a client may select. Empty = primary + fallback.
TRANSLATION_ALLOWED_MODELS=
TRANSLATION_THINKING_LEVEL=low
TRANSLATION_TIMEOUT_MS=8000
# No translated text by then -> start a second request in parallel and use whichever answers first (0 = off).
TRANSLATION_HEDGE_AFTER_MS=1200
# An attempt with no translated text by then is abandoned.
TRANSLATION_FIRST_TOKEN_TIMEOUT_MS=4000

# --- Limits ---
MAX_SESSIONS=1
MAX_SESSION_MINUTES=120
# Content persistence is not implemented; any value other than false is refused.
STORE_CONTENT=false
