# LiveBridge gateway configuration. Copy to .env (git-ignored) and fill in. Never commit real values.
# The gateway validates everything at startup and refuses to start on a missing or malformed value.

HOST=127.0.0.1
PORT=8201

# real = ElevenLabs + Gemini. fake = deterministic placeholder text and test tones (no keys needed, not a translation).
PROVIDER_MODE=real

# Long-lived client credential (>= 32 characters). The desktop app keeps it in the macOS Keychain or the Windows
# Credential Manager. Empty switches token mode off (accounts and own keys still work).
# Generate one with:  openssl rand -base64 36
GATEWAY_ACCESS_TOKEN=

# --- Accounts (optional; both must be set to turn them on) ---
# Unix socket of the site that holds accounts and balances.
SITE_SOCKET_PATH=
# Host header the gateway sends on that socket.
SITE_HOST=jaysonkhan.com
# Shared secret that authenticates the gateway to the site (>= 32 characters). Generate with: openssl rand -base64 36
LIVEBRIDGE_GATEWAY_SECRET=
# Comma-separated voice ids an account session may use. Empty = none listed.
ACCOUNT_VOICE_IDS=

# --- ElevenLabs (speech-to-text and speech synthesis) ---
# Use a dedicated key with only Speech to Text + Text to Speech permissions and a monthly usage limit.
# Add the Voices read permission (`voices_read`) if the app should list the account's voices to choose from;
# without it the list is unavailable and the two voices below are used.
ELEVENLABS_API_KEY=
# Voices. The default for both is "JaysonKhan - Natural Uzbek Voice": the project author's own voice, published by
# the author in the ElevenLabs Voice Library (it speaks English, Russian, Uzbek and Turkish). Library voices need a
# paid ElevenLabs plan; if your account rejects the id, add the voice to "My Voices" from the Voice Library and put
# the id shown there. Replace either line with a voice you are authorised to use (e.g. your own clone).
# Outgoing English / Russian speech (what the other participant hears):
ELEVENLABS_OWNER_VOICE_ID=ehTFHBkERkWR22A3sR8M
# Incoming Uzbek speech (what you hear). May be the same voice. Never clone the remote participant.
ELEVENLABS_INCOMING_VOICE_ID=ehTFHBkERkWR22A3sR8M
# Voice categories left out of the list the app chooses from (comma-separated, e.g. cloned,generated). Empty = none.
VOICES_EXCLUDED_CATEGORIES=
# Optional regional host, e.g. https://api.eu.residency.elevenlabs.io
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
STT_MODEL=scribe_v3_live
STT_VAD_SILENCE_SECS=0.6
TTS_MODEL=eleven_v4_turbo
# Raw PCM only. Run `npm run probe` to confirm which pcm_<rate> values your plan accepts on the dialogue socket.
TTS_OUTPUT_FORMAT=pcm_24000

# --- Translation (Gemini streaming generateContent) ---
TRANSLATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Chosen by measurement on 2026-11-24 (docs/benchmark.md): fastest and most available of the candidates.
TRANSLATION_MODEL=gemini-3.5-flash-lite
# Same provider and privacy terms as the primary. Leave empty to disable fallback.
TRANSLATION_FALLBACK_MODEL=gemini-3.8-flash
# Comma-separated models a client may select. Empty = primary + fallback.
TRANSLATION_ALLOWED_MODELS=
TRANSLATION_THINKING_LEVEL=low
TRANSLATION_TIMEOUT_MS=8000
# No translated text by then -> start a second request in parallel and use whichever answers first (0 = off).
TRANSLATION_HEDGE_AFTER_MS=1200
# An attempt with no translated text by then is abandoned.
TRANSLATION_FIRST_TOKEN_TIMEOUT_MS=4000

# --- Limits ---
MAX_SESSIONS=1
# Per-mode caps; leave empty to use MAX_SESSIONS.
MAX_ACCOUNT_SESSIONS=
MAX_KEYS_SESSIONS=
# Slots of the total that only account sessions may take.
PAID_RESERVED_SESSIONS=0
# No speech on either lane for this many minutes ends the session (0 = off).
IDLE_TIMEOUT_MINUTES=10
# How often an account session reports usage to the site, in seconds (>= 2).
USAGE_REPORT_SECONDS=10
MAX_SESSION_MINUTES=120
# Content persistence is not implemented; any value other than false is refused.
STORE_CONTENT=false
