<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.jaysonkhan.livebridge.lbaudio</string>
	<key>CFBundleName</key>
	<string>lbaudio</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>LiveBridge captures your microphone so your speech can be translated during a call you started.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>LiveBridge captures the audio of the meeting app you selected so the other participant's speech can be translated.</string>
</dict>
</plist>
