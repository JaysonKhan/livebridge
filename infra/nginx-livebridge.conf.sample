# Sample nginx vhost. Replace bridge.example.com, obtain the certificate first, then copy to
# /etc/nginx/sites-enabled/livebridge.conf and run `sudo nginx -t && sudo systemctl reload nginx`.
# The gateway needs its own server_name and DNS A record.

limit_conn_zone $binary_remote_addr zone=livebridge_conn:1m;

server {
    # `listen ... http2` is understood by every nginx in use (Ubuntu 24.04 ships 1.24); from 1.25.1 the separate
    # `http2 on;` directive is the preferred spelling.
    listen 443 ssl http2;
    server_name bridge.example.com;

    ssl_certificate     /etc/letsencrypt/live/bridge.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bridge.example.com/privkey.pem;

    # Tokens travel in the Authorization header, never the URL, but keep query strings out of logs anyway
    # (define a log_format without $request / $args, or use your server's existing safe format).
    access_log /var/log/nginx/livebridge.access.log;
    # Its own error log as well: ban rules that watch the server's shared logs then never see this vhost's refusals.
    error_log /var/log/nginx/livebridge.error.log;

    # A personal tool: a handful of connections per address is plenty.
    limit_conn livebridge_conn 4;
    client_max_body_size 16k;

    location = /healthz {
        proxy_pass http://127.0.0.1:8201;
    }

    location /v1/ {
        proxy_pass http://127.0.0.1:8201;
        proxy_http_version 1.1;
        # WebSocket upgrade for /v1/realtime.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Calls are long-lived and audio must not be buffered.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location / {
        return 404;
    }
}

server {
    listen 80;
    server_name bridge.example.com;
    return 301 https://$host$request_uri;
}
